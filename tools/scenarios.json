{
  "schema": "rand-fast/scenarios/v1",
  "notes": [
    "Each scenario declares a fixture, an optional set of background commands, the prerequisites it genuinely needs, and the evidence the QEMU matrix requires.",
    "Measured values are read from `fast diagnose --format json`; the fixture writes its own --report as an independent reference.",
    "A scenario whose required prerequisite is missing FAILS. Only genuinely optional capabilities may be reported as unavailable."
  ],
  "scenarios": [
    {
      "name": "cpu-saturation",
      "kind": "positive",
      "description": "One CPU-bound thread. The process consumes a full core while the run queue stays free.",
      "fixture": [
        "sched-workload",
        "hog",
        "--duration",
        "6s",
        "--workers",
        "1"
      ],
      "background": [],
      "prerequisites": [
        "tracefs",
        "btf"
      ],
      "duration_s": 4,
      "expect": {
        "measured": {
          "cpu_percent": {
            "min": 5
          }
        },
        "top1": [
          "CPU contention"
        ]
      }
    },
    {
      "name": "sched-contention",
      "kind": "positive",
      "description": "A low-CPU periodic target while twice the online CPUs spin in separate processes. The target's own CPU use stays low; its run-queue wait does not.",
      "fixture": [
        "sched-workload",
        "target",
        "--duration",
        "6s",
        "--period",
        "5ms"
      ],
      "background": [
        [
          "sched-workload",
          "hog",
          "--duration",
          "8s",
          "--workers",
          "8"
        ],
        [
          "sched-workload",
          "hog",
          "--duration",
          "8s",
          "--workers",
          "8"
        ]
      ],
      "prerequisites": [
        "tracefs",
        "btf",
        "cpu2"
      ],
      "duration_s": 4,
      "expect": {
        "measured": {
          "sched_p95_us": {
            "min": 1000
          },
          "cpu_percent": {
            "max": 80
          }
        },
        "contains_any": [
          "Scheduler latency"
        ],
        "report_p95_min_us": 1000
      }
    },
    {
      "name": "block-io",
      "kind": "positive",
      "description": "O_DIRECT reads from a file on the guest's ext4 virtio disk, so block requests reach the device.",
      "fixture": [
        "fast-workload",
        "io-hog",
        "--duration",
        "6s",
        "--workers",
        "2",
        "--path",
        "@IO_HOG_PATH@",
        "--size-mib",
        "64"
      ],
      "background": [],
      "prerequisites": [
        "tracefs",
        "btf",
        "block_device"
      ],
      "duration_s": 4,
      "expect": {
        "measured": {
          "io_samples": {
            "min": 1
          }
        },
        "top1": [
          "Disk I/O"
        ]
      }
    },
    {
      "name": "lock-contention",
      "kind": "positive",
      "description": "Sixteen threads convoy on one futex with a short hold time, producing real off-CPU lock waits.",
      "fixture": [
        "fast-workload",
        "lock-hog",
        "--duration",
        "6s",
        "--workers",
        "16",
        "--hold-ms",
        "1"
      ],
      "background": [],
      "prerequisites": [
        "tracefs",
        "btf"
      ],
      "duration_s": 4,
      "expect": {
        "measured": {
          "offcpu_samples": {
            "min": 100
          },
          "offcpu_futex_ratio": {
            "min": 0.2
          }
        },
        "top1": [
          "Lock contention"
        ]
      }
    },
    {
      "name": "memory-pressure",
      "kind": "positive",
      "description": "Fresh anonymous mappings faulted and released every round, forcing minor faults and direct reclaim. On a small emulated guest the same page-fault churn is also visible as CPU work, so the required assertion is that the memory signal is measured and ranked.",
      "fixture": [
        "fast-workload",
        "mem-hog",
        "--duration",
        "6s",
        "--workers",
        "1",
        "--size-mib",
        "1024"
      ],
      "background": [],
      "prerequisites": [
        "tracefs",
        "btf"
      ],
      "duration_s": 4,
      "expect": {
        "measured": {
          "minor_faults_per_s": {
            "min": 100
          }
        },
        "contains_any": [
          "Memory pressure"
        ]
      }
    },
    {
      "name": "slow-socket-peer",
      "kind": "positive",
      "description": "Loopback clients on a healthy connection whose peer stops reading, closing the receive window and stalling the request.",
      "fixture": [
        "fast-workload",
        "net-hog",
        "--duration",
        "6s",
        "--workers",
        "2",
        "--delay-ms",
        "600"
      ],
      "background": [],
      "prerequisites": [
        "tracefs",
        "btf"
      ],
      "duration_s": 4,
      "expect": {
        "measured": {
          "offcpu_samples": {
            "min": 10
          },
          "offcpu_network_ratio": {
            "min": 0.1
          }
        },
        "top1": [
          "Network"
        ]
      }
    },
    {
      "name": "mixed-lock-io",
      "kind": "mixed",
      "description": "The same process holds a contended futex and reads a real block device, so two measured signals are present at once.",
      "fixture": [
        "fast-workload",
        "mixed-hog",
        "--duration",
        "6s",
        "--workers",
        "16",
        "--hold-ms",
        "1",
        "--path",
        "@IO_HOG_PATH@",
        "--size-mib",
        "32",
        "--io-workers",
        "1"
      ],
      "background": [],
      "prerequisites": [
        "tracefs",
        "btf",
        "block_device"
      ],
      "duration_s": 4,
      "expect": {
        "measured": {
          "io_samples": {
            "min": 1
          },
          "offcpu_futex_ratio": {
            "min": 0.05
          }
        },
        "contains_any": [
          "Lock contention",
          "Disk I/O"
        ]
      }
    },
    {
      "name": "slow-peer-delay",
      "kind": "positive",
      "description": "A healthy loopback connection whose echo server thinks for 100ms before replying. The client is blocked in a socket read, not waiting for a retransmission.",
      "fixture": [
        "fast-workload",
        "net-hog",
        "--duration",
        "6s",
        "--workers",
        "2",
        "--peer-delay-ms",
        "100"
      ],
      "background": [],
      "prerequisites": [
        "tracefs",
        "btf"
      ],
      "duration_s": 4,
      "expect": {
        "measured": {
          "offcpu_samples": {
            "min": 10
          },
          "offcpu_network_ratio": {
            "min": 0.1
          }
        },
        "contains_any": [
          "Network"
        ],
        "report_p95_min_us": 50000
      }
    },
    {
      "name": "idle-control",
      "kind": "control",
      "description": "A healthy process that wakes every 50ms and does almost no work. No contention signal should be reported.",
      "fixture": [
        "sched-workload",
        "target",
        "--duration",
        "6s",
        "--period",
        "50ms"
      ],
      "background": [],
      "prerequisites": [
        "tracefs",
        "btf"
      ],
      "duration_s": 4,
      "expect": {
        "measured": {
          "cpu_percent": {
            "max": 20
          },
          "sched_samples": {
            "min": 1
          }
        },
        "exclude": [
          "CPU contention",
          "Scheduler latency",
          "Disk I/O",
          "Lock contention",
          "Memory pressure",
          "Network"
        ]
      }
    }
  ]
}
